FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0.001";
    object      n.49;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    lowerWall
    {
        type            zeroGradient;
    }
    atmosphere
    {
        type            zeroGradient;
    }
    rightWall
    {
        type            empty;
    }
    leftWall
    {
        type            empty;
    }
    	    Front
    {
        type            zeroGradient;
    }
    Back
    {
        type            zeroGradient;
    }
}


// ************************************************************************* //
